;; Import definitions used to create kernel32.lib without the Windows SDK.
;; Only functions that exist on Windows 7.
LIBRARY kernel32.dll
EXPORTS
    DisableThreadLibraryCalls
    ExitProcess
    FreeLibrary
    GetCommandLineW
    GetModuleHandleW
    GetProcAddress
    GetProcessHeap
    GetStdHandle
    HeapAlloc
    HeapFree
    LoadLibraryExW
    LoadLibraryW
    OutputDebugStringW
    WriteFile
