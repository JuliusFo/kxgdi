;; Import definitions used to create kernel32.lib without the Windows SDK.
;; Only functions that exist on Windows 7.
LIBRARY kernel32.dll
EXPORTS
    AcquireSRWLockExclusive
    DisableThreadLibraryCalls
    ExitProcess
    FreeLibrary
    GetCommandLineW
    GetModuleFileNameW
    GetModuleHandleW
    GetProcAddress
    GetProcessHandleCount
    GetProcessHeap
    GetStdHandle
    HeapAlloc
    HeapFree
    LoadLibraryExW
    LoadLibraryW
    OutputDebugStringW
    ReleaseSRWLockExclusive
    WriteFile
